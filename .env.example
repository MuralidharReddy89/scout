# Copy this file to `.env` and fill in your own values.
# `.env` is gitignored, so secrets stay on your machine.
#
# Variables are loaded automatically by the `scout` CLI before each run.
# Values already set in the shell (e.g. `$env:ANTHROPIC_API_KEY = "..."`
# in PowerShell) win over what's in `.env`.

# --- Required for live runs ---------------------------------------------
# Get one at https://console.anthropic.com/settings/keys
# WARNING: paste on a single line, no leading/trailing whitespace.
ANTHROPIC_API_KEY=

# --- Optional overrides -------------------------------------------------
# Anthropic model identifier. Defaults to claude-sonnet-4-5-20250929.
# SCOUT_LLM_MODEL=claude-sonnet-4-5-20250929

# Hard cap on the agent's wall-clock budget (seconds). Default: 120.
# SCOUT_MAX_WALL_SECONDS=120

# Hard cap on the number of pages the agent may visit. Default: 20.
# SCOUT_MAX_PAGES=20

# Hard cap on total LLM tokens (input + output). Default: unset = unlimited.
# SCOUT_MAX_TOKENS=200000

# Hard cap on total LLM spend in USD. Default: unset = unlimited.
# SCOUT_MAX_USD=1.00

# --- Integration test toggle (CI/dev only) ------------------------------
# Set to "1" to opt the live Playwright + Anthropic tests into a pytest run.
# SCOUT_RUN_BROWSER_INTEGRATION=0
